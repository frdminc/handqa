# Copy to .env (`chmod 600 .env`). `just` loads it automatically.
# Point FIRERPA_CERT at the standalone installer's lamda.pem (keep outside git).
FIRERPA_HOST=127.0.0.1
FIRERPA_PORT=65000
FIRERPA_CERT=/absolute/path/to/lamda.pem
FIRERPA_VERSION=10.12

# Required for a guided run. Use a transport ID listed by `adb devices`.
ADB_TARGET=

# Optional project profile (e.g. `plektra`) and target keyboard package ID.
# When omitted, handqa records passes against whichever IME is active on the phone.
# HANDQA_PROFILE=plektra
# HANDQA_PACKAGE=rocks.pkb.plektra

# Optional keymap profile and voice backend overrides:
# HANDQA_KEYMAP=profiles/plektra/keymaps/titan2-elite-baseline.yaml
# HANDQA_VOICE=auto          # auto, kokoro, say, espeak, or off
# HANDQA_VOICE_NAME=af_heart
# HANDQA_RECORD_DIR=~/handqa-recordings
